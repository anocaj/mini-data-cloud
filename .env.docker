# Docker Environment Configuration for Mini Data Cloud with Iceberg Integration

# PostgreSQL Configuration
POSTGRES_DB=minicloud_catalog
POSTGRES_USER=minicloud
POSTGRES_PASSWORD=minicloud123
POSTGRES_URL=jdbc:postgresql://metadata-db:5432/minicloud_catalog

# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# AWS S3 Configuration (for Iceberg)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=http://minio:9000

# Iceberg Configuration
ICEBERG_ENABLED=true
ICEBERG_CATALOG_TYPE=jdbc
ICEBERG_WAREHOUSE=s3a://iceberg-data/

# Application Configuration
SPRING_PROFILES_ACTIVE=docker
MINICLOUD_DOCKER_ENABLED=false
MINICLOUD_DATA_PATH=/data

# Worker Configuration
MAX_MEMORY_MB=2048
CONTROL_PLANE_ENDPOINT=control-plane:9090

# Monitoring Configuration
GF_SECURITY_ADMIN_PASSWORD=admin